import java.util.Scanner;

public class Main {

 static void oddPairs(int a[]){
    for(int i=0;i<a.length;i++){
        for(int j=i+1;j<a.length;j++){
            if(a[i]%2!=0&&a[j]%2!=0){
                System.out.println(a[i]+" "+a[j]);
            }
        }
    }
 }
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int []a=new int[n];
        for(int i=0;i<n;i++){
            a[i]=sc.nextInt();
        }
        oddPairs(a);
        
    }
}
