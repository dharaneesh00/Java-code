import java.util.*;
class Main
{
	static void zeroBack(int []a) {
		int index=0;
		for(int i=0;i<a.length;i++)
		{
			if(a[i]!=0) {
				a[index]=a[i];
						index++;
				}
			}
		while (index < a.length) {
            a[index] = 0;
            index++;
        }
		for (int i = 0; i < a.length; i++) {
			System.out.print(a[i]);
			}

}
	public static void main(String[]args) {
		Scanner sc=new Scanner(System.in);
		int n= sc.nextInt();
		int []a=new int[n];
		for (int i = 0; i < n; i++) {
			a[i]=sc.nextInt();
		}
		 zeroBack(a);
		
	}
}
