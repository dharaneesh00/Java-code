import java.util.*;

public class Main {
    static void minPair(int []a){
        int m1,m2;
        if(a[0]<a[1]){
            m1=a[0];
            m2=a[1];
        }
        else{
            m1=a[1];
            m2=a[0];
        }
        for(int i=2;i<a.length;i++){
            if(a[i]<m1){
                m2=m1;
                m1=a[i];
            }
            else if(m2>a[i]&&m1!=a[i]){
                m2=a[i];
            }
        }
        System.out.print(m1+m2);
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n=sc.nextInt();
        int []a=new int[n];
        for(int i=0;i<n;i++){
            a[i]=sc.nextInt();
        }
        minPair(a);
        
    }
}
